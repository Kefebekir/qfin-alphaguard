{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": "arn:aws:ecs:eu-north-1:*:task-definition/qfin-alphaguard:*"
    },
    {
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::*:role/qfin-execution-role",
        "arn:aws:iam::*:role/qfin-task-role"
      ],
      "Condition": {
        "StringLike": { "iam:PassedToService": "ecs-tasks.amazonaws.com" }
      }
    }
  ]
}
